# Sponsor Portal — example environment.
# Copy to .env, fill in real values, and keep that file at mode 0600.
# Never commit a filled-in .env, and never pass these values as CLI arguments.

# ---------------------------------------------------------------- server
HOST=127.0.0.1
PORT=8080
# Set to true only when a reverse proxy in front sets X-Forwarded-* headers.
TRUST_PROXY=false
DATABASE_PATH=/data/portal.db

# ---------------------------------------------------------------- secrets
# Both are REQUIRED in production; the process refuses to start without them.
# Generate with: openssl rand -base64 48
COOKIE_SECRET=
# Encrypts the OAuth credential envelope at rest. Rotating this value makes
# every stored credential undecryptable — every sponsor must re-authenticate.
CREDENTIAL_ENCRYPTION_KEY=

SESSION_HOURS=12
OAUTH_STATE_MINUTES=10

# ---------------------------------------------------------------- bootstrap admin
# Seeded once, only when the users table is empty. The seeded admin is forced
# to change this password at first login.
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Claude OAuth
CLAUDE_CLIENT_ID=
CLAUDE_AUTHORIZE_URL=https://claude.ai/oauth/authorize
CLAUDE_TOKEN_URL=https://api.anthropic.com/v1/oauth/token
CLAUDE_SCOPES=org:create_api_key user:profile user:inference
CLAUDE_REDIRECT_URI=

# ---------------------------------------------------------------- Codex OAuth
CODEX_CLIENT_ID=
CODEX_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
CODEX_TOKEN_URL=https://auth.openai.com/oauth/token
CODEX_SCOPES=openid profile email offline_access
# Codex CLI pins its callback to localhost:1455. On the zbs3 llm-gateway stack
# that host port is already bound by llm-gateway-9router, so the portal cannot
# publish it — see README "Codex callback và port 1455" for the open options.
# Leave empty until one is chosen; /api/oauth/codex/start returns 400 meanwhile.
CODEX_REDIRECT_URI=

# ---------------------------------------------------------------- routers
# Privileged tokens let the portal write provider connections into each router.
# Treat them as admin credentials.
NINEROUTER_URL=http://llm-gateway-9router:20128
NINEROUTER_PRIVILEGED_TOKEN=

OMNIROUTE_URL=http://llm-gateway-omniroute:20131
OMNIROUTE_PRIVILEGED_TOKEN=
