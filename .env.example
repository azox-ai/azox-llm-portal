# LLM Portal — example environment.
# Copy to .env, fill in real values, and keep that file at mode 0600.
# Never commit a filled-in .env, and never pass these values as CLI arguments.

# ---------------------------------------------------------------- server
HOST=127.0.0.1
PORT=8080
# Set to true only when a reverse proxy in front sets X-Forwarded-* headers.
TRUST_PROXY=false
DATABASE_PATH=/data/portal.db

# Set to true ONLY when browsers reach the portal over plain HTTP (e.g. the
# zbs0 Tailscale address, which has no TLS listener). This relaxes two things
# that otherwise make the UI unusable without TLS: `secure` session cookies,
# which the browser would refuse to store, and CSP `upgrade-insecure-requests`,
# which would rewrite /app.js and /styles.css to https:// and yield a blank
# page. Leave unset behind TLS so HSTS and secure cookies stay on.
INSECURE_HTTP=false

# ---------------------------------------------------------------- secrets
# Both are REQUIRED in production; the process refuses to start without them.
# Generate with: openssl rand -base64 48
COOKIE_SECRET=
# Encrypts the OAuth credential envelope at rest. Rotating this value makes
# every stored credential undecryptable — every sponsor must re-authenticate.
CREDENTIAL_ENCRYPTION_KEY=

SESSION_HOURS=12
OAUTH_STATE_MINUTES=10
REFRESH_LEAD_MINUTES=480
REFRESH_INTERVAL_MINUTES=5
QUOTA_CHECK_INTERVAL_MINUTES=5

# ---------------------------------------------------------------- bootstrap admin
# Seeded once, only when no admin exists. No forced first-login password change.
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Claude OAuth
# All four have working defaults matching the vendor CLI clients (public,
# PKCE-protected values). Override only to pin a different client.
CLAUDE_CLIENT_ID=
CLAUDE_AUTHORIZE_URL=
CLAUDE_TOKEN_URL=
CLAUDE_SCOPES=
# Claude's manual flow shows the code in the browser instead of redirecting.
CLAUDE_REDIRECT_URI=

# ---------------------------------------------------------------- Codex OAuth
# Defaults match the Codex CLI client. The callback port 1455 is owned by
# llm-gateway-9router on this host, so the portal never listens for the
# redirect: the operator pastes the callback URL back into the UI.
CODEX_CLIENT_ID=
CODEX_AUTHORIZE_URL=
CODEX_TOKEN_URL=
CODEX_SCOPES=
CODEX_REDIRECT_URI=

# ---------------------------------------------------------------- router sync
# Shared with 9Router PORTAL_SYNC_TOKEN; keep it secret and only expose the
# endpoint through the Docker network.
NINEROUTER_URL=http://llm-gateway-9router:20128
NINEROUTER_SYNC_TOKEN=
