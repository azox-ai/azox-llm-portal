# Isolated unified gateway — example configuration.
# Copy outside the repository, chmod 600, and never commit the real values.
# UNIFIED_ENCRYPTION_KEY: base64 of 32 random bytes (openssl rand -base64 32).
# Losing this key makes every stored credential unrecoverable.
UNIFIED_LISTEN=127.0.0.1:3030
UNIFIED_DATABASE_PATH=./data/unified.sqlite
UNIFIED_ENCRYPTION_KEY=
UNIFIED_ADMIN_USERNAME=admin
UNIFIED_ADMIN_PASSWORD=
UNIFIED_ALLOW_UPSTREAM=false
UNIFIED_WEB_DIR=./web/dist
# Optional: bearer token for the inbound portal connection-sync contract.
# PORTAL_SYNC_TOKEN=